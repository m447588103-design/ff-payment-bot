# Copy to .env and fill in real values. Never commit .env to GitHub.
# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Server (guild) ID where the bot posts the payment panel and slash commands
GUILD_ID=

# Where the SQLite database lives (create the folder or let the bot create it)
DATABASE_PATH=data/payments.sqlite3

# Optional defaults (you can also set these with /payadmin setup)
REGISTRATION_FEE=100
BKASH_NUMBER=
NAGAD_NUMBER=
ROCKET_NUMBER=
REVIEW_CHANNEL_ID=
ADMIN_ROLE_ID=

# Member who receives the Approve/Reject DM for every submission.
# /payadmin setup sets this too; the member must allow DMs from the server.
NOTIFICATION_USER_ID=

# Headline of the player payment panel embed
PAYMENT_TITLE=FF Esports Registration

# Neon checkout banner shown at the top of the payment panel.
# The file is uploaded when /payment_panel is run (needs the Attach Files permission).
# Optional: if the file is missing or the upload is refused, the panel is posted
# without the image. Leave empty to disable the banner. Relative paths are resolved
# from the bot folder.
PAYMENT_BANNER_PATH=assets/payment_banner.png

# Optional alternative: an already-hosted image URL. When set it is embedded
# directly instead of uploading PAYMENT_BANNER_PATH, so no Attach Files is needed.
PAYMENT_BANNER_URL=
